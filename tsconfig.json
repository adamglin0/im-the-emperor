{
  "compilerOptions": {
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noUncheckedIndexedAccess": false,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "verbatimModuleSyntax": false,
    "types": ["node"],
    "lib": ["ES2023", "DOM"]
  },
  "include": ["packages/shared/src", "packages/hub/src", "packages/gateway/src", "packages/dept/src", "packages/sandbox/src", "tests"]
}
