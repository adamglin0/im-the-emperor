# 复制为 .env，或直接运行 scripts/court.sh init 自动生成（随机 token）。
# 网关 token：hub 调网关（考场/阅卷）、网关调 hub（预算/记账）
GATEWAY_TOKEN=gw_change_me
# hub → 部门控制面（门铃、暂停/恢复）
CONTROL_TOKEN=ctl_change_me
# 部门（兵/工/刑）→ 将作监沙箱
SANDBOX_TOKEN=sb_change_me
# hub ↔ MCP 中转站（broker）共用密钥；只注入 hub 与 mcp 两个服务，部门读不到
MCP_TOKEN=mc_change_me
# hub → 网关管理接口（模型提供商设置）；与 GATEWAY_TOKEN 分开，部门容器读不到
GATEWAY_ADMIN_TOKEN=gwa_change_me
# real | mock（mock = 网关用确定性「mock 大脑」，零成本跑通全流程）
LLM_MODE=real
# pi 的 auth.json（{ "opencode-go": { "type": "api_key", "key": "..." } }），只挂载进网关容器
PI_AUTH_FILE=/Users/you/.pi/agent/auth.json
# 或者直接给密钥（优先于 auth.json）；没有 auth.json 时把 PI_AUTH_FILE 设为 /dev/null
OPENCODE_API_KEY=
# 网关每提供商并发上限
GATEWAY_MAX_CONCURRENCY=6
# 可选：构建沙箱镜像时的 Debian 镜像源（官方源慢时如 mirrors.aliyun.com）
DEBIAN_MIRROR=
# 沙箱工作区：./data/sandbox（Linux）或 sandbox-workspaces（命名卷；macOS 必须用它，工作区 uid 隔离才生效）
SANDBOX_WORKSPACES=./data/sandbox
